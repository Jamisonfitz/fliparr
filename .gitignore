# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# testing
/coverage

# ---------------------------------------------------------------------------
# Anything that could carry a real instance's details.
# This repo is meant to be publishable at any moment: no keys, no hostnames,
# no library contents. .env.example is the only env file that ships, and it
# holds placeholders.
# ---------------------------------------------------------------------------

# Env files of every flavour
.env
.env.*
!.env.example

# Runtime state: the saved Radarr address, API key, and swipe history
/data
/config
fliparr.json
*.sqlite
*.sqlite3
*.db

# Deploy scripts and compose overrides usually written against a real host
docker-compose.override.yml
docker-compose.*.local.yml
deploy.sh
deploy.local.*
*.local.sh

# Captured API responses and scratch debugging output
*.local.json
scratch/
tmp/
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Credentials and keys of any kind
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
secrets.*
*.secret

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Deployment platforms
.vercel
